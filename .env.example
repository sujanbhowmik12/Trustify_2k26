# Trustify Environment Variables
ENV=development
PORT=3000

# Base URLs
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
APP_URL=http://localhost:3000

# Database Configuration (Neon PostgreSQL / Vercel Postgres)
# Provide your PostgreSQL connection string for production persistence on Vercel:
# DATABASE_URL=postgresql://neondb_owner:password@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Or Vercel Postgres automatically injects POSTGRES_URL:
# POSTGRES_URL=

# Scanner Settings
SCAN_TIMEOUT_MS=6000
MAX_REDIRECTS=8
ALLOW_PRIVATE_TARGETS=false

# Optional External API Keys (Leave blank for built-in heuristics and mock feeds)
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_API_KEY=
WHOIS_API_KEY=

